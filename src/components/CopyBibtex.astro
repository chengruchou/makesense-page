---
// BibTeX in a code block with a copy button under it. The button's text is its name; the result is announced.
import Icon from "./Icon.astro";

interface Props {
  bibtex: string;
}

const { bibtex } = Astro.props;
---

<div class="bibtex-block" data-bibtex>
  <div class="bibtex-box">
    <pre class="bibtex"><code translate="no">{bibtex}</code></pre>
  </div>
  <div class="bibtex-actions">
    <button type="button" class="copy" data-copy>
      <Icon name="copy" class="icon-copy" />
      <Icon name="check" class="icon-done" />
      <span data-copy-label>Copy BibTeX</span>
    </button>
    <p class="copy-status muted" role="status" data-copy-status></p>
  </div>
</div>

<script>
  for (const block of document.querySelectorAll<HTMLElement>("[data-bibtex]")) {
    const button = block.querySelector<HTMLButtonElement>("[data-copy]");
    const label = block.querySelector<HTMLElement>("[data-copy-label]");
    const status = block.querySelector<HTMLElement>("[data-copy-status]");
    const text = block.querySelector("code")?.textContent ?? "";
    let timer = 0;
    button?.addEventListener("click", async () => {
      window.clearTimeout(timer);
      try {
        await navigator.clipboard.writeText(text);
        button.toggleAttribute("data-copied", true);
        if (label) label.textContent = "Copied";
        if (status) status.textContent = "BibTeX copied to the clipboard.";
        timer = window.setTimeout(() => {
          button.removeAttribute("data-copied");
          if (label) label.textContent = "Copy BibTeX";
          if (status) status.textContent = "";
        }, 2500);
      } catch {
        if (status) status.textContent = "Copying failed. Select the text and copy it.";
      }
    });
  }
</script>
